      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Null Profit Count' datatype='integer' name='[Calculation_1611635355643905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(ISNULL([Profit]), 1, 0)' />
      </column>
      <column caption='Null Postal Code Count' datatype='integer' name='[Calculation_1611635357085699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(ISNULL([Postal Code]), 1, 0)' />
      </column>
      <column caption='Postal Code Clean' datatype='string' name='[Calculation_1611635359498244]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Postal Code]), &quot;Unknown&quot;)' />
      </column>
      <column caption='Null Postal Clean Count' datatype='integer' name='[Calculation_1611635360362501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(ISNULL([Calculation_1611635359498244]), 1, 0)' />
      </column>
      <column caption='Outlier Flag' datatype='string' name='[Calculation_1611635373338631]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ABS([Profit]) &gt; 2000 THEN &quot;Outlier&quot; ELSE &quot;Normal&quot; END' />
      </column>
